# Salin file ini jadi `.env` lalu isi dengan nilai project Supabase kamu.
# `.env` TIDAK boleh di-commit — lihat .gitignore.
#
# Catatan: variabel berawalan VITE_ ikut ter-bundle ke JavaScript yang dikirim
# ke browser, jadi nilainya bersifat publik. Jangan pernah menaruh service role
# key atau secret lain di sini — pengamanan data harus lewat RLS di Supabase.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
